---
import ToolIcon from './ToolIcon.astro';
const { tool } = Astro.props;
---
<div class="card" data-tool={tool.id} tabindex="0" role="button"
     onclick={`openTool('${tool.path}','${tool.id}')`}
     onkeydown={`if(event.key==='Enter')openTool('${tool.path}','${tool.id}')`}>
  <div class="card-tag">{tool.tag}</div>
  <ToolIcon iconName={tool.iconName} />
  <h2 class="card-title">{tool.title}</h2>
  <p class="card-desc">{tool.description}</p>
  <div class="card-cta">{tool.cta} <span aria-hidden="true">&#8594;</span></div>
</div>

<style>
  .card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 1.625rem 1.375rem 1.375rem;
    cursor: pointer;
    transition: transform 0.25s cubic-bezier(.4,0,.2,1),
                border-color 0.25s,
                box-shadow 0.25s;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: var(--card-stripe);
    transform: scaleX(0.35);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(.4,0,.2,1);
  }

  .card:hover::before  { transform: scaleX(1); }

  .card:hover {
    border-color: var(--border-bright);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.25);
  }

  .card:focus-visible { outline: 2px solid var(--accent-a); outline-offset: 2px; }

  .card[data-tool="membranes"] { --card-stripe: linear-gradient(90deg, var(--accent-a), var(--accent-g)); }
  .card[data-tool="psystems"]  { --card-stripe: linear-gradient(90deg, var(--accent-g), var(--accent-c)); }
  .card[data-tool="swarms"]    { --card-stripe: linear-gradient(90deg, var(--accent-c), var(--accent-t)); }

  .card-tag {
    font-size: 0.55rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 1rem;
  }

  /* Target both internal selector and child component root SVG */
  .card-icon,
  :global(.card-icon) {
    width: 40px;
    height: 40px;
    margin-bottom: 0.875rem;
    color: var(--text-sub);
    transition: color 0.2s;
  }

  .card:hover .card-icon,
  .card:hover :global(.card-icon) { color: var(--text); }

  .card-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }

  .card-desc {
    font-size: 0.63rem;
    line-height: 1.7;
    color: var(--text-sub);
  }

  .card-cta {
    margin-top: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
    transition: color 0.2s, gap 0.2s;
  }

  .card:hover .card-cta { color: var(--accent-a); gap: 0.625rem; }

  @media (max-width: 480px) {
    .card { padding: 1.25rem 1.125rem; }
    .card-desc { font-size: 0.68rem; }
  }
</style>

