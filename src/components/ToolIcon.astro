---
const { iconName } = Astro.props;
---
<svg class="card-icon" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
  {iconName === 'membranes' && (
    <>
      <ellipse cx="20" cy="20" rx="18" ry="11" stroke-dasharray="3 2"/>
      <ellipse cx="20" cy="20" rx="11" ry="7"/>
      <circle  cx="20" cy="20" r="3" fill="currentColor" stroke="none" opacity="0.5"/>
      <line x1="14" y1="16" x2="20" y2="20" stroke-width="1" opacity="0.4"/>
      <line x1="26" y1="16" x2="20" y2="20" stroke-width="1" opacity="0.4"/>
    </>
  )}

  {iconName === 'psystems' && (
    <>
      <rect x="3"  y="3"  width="34" height="34" rx="6" stroke-dasharray="4 2"/>
      <rect x="10" y="10" width="20" height="20" rx="4"/>
      <rect x="16" y="16" width="8"  height="8"  rx="2" fill="currentColor" opacity="0.25" stroke-width="1"/>
      <circle cx="20" cy="20" r="1.5" fill="currentColor" stroke="none"/>
    </>
  )}

  {iconName === 'swarms' && (
    <>
      <circle cx="20" cy="20" r="3.5" fill="currentColor" opacity="0.35"/>
      <circle cx="9"  cy="14" r="2.5"/>
      <circle cx="31" cy="14" r="2.5"/>
      <circle cx="9"  cy="26" r="2.5"/>
      <circle cx="31" cy="26" r="2.5"/>
      <circle cx="20" cy="7"  r="2.5"/>
      <circle cx="20" cy="33" r="2.5"/>
      <line x1="11.5" y1="15.5" x2="17.5" y2="18"   stroke-width="1" opacity="0.4"/>
      <line x1="28.5" y1="15.5" x2="22.5" y2="18"   stroke-width="1" opacity="0.4"/>
      <line x1="11.5" y1="24.5" x2="17.5" y2="22"   stroke-width="1" opacity="0.4"/>
      <line x1="28.5" y1="24.5" x2="22.5" y2="22"   stroke-width="1" opacity="0.4"/>
      <line x1="20"   y1="9.5"  x2="20"   y2="16.5" stroke-width="1" opacity="0.4"/>
      <line x1="20"   y1="30.5" x2="20"   y2="23.5" stroke-width="1" opacity="0.4"/>
    </>
  )}
</svg>
