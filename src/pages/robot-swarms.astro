---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Robot Swarm Simulator</title>
    <link rel="icon" href="../favicon.ico">
    <script is:inline src="../theme-init.js"></script>
    <style>
        body {
            font-family: 'IBM Plex Mono', monospace;
            overscroll-behavior: none;
        }
        .grid-wrapper {
            display: grid;
            grid-template-areas:
                ". col-labels"
                "row-labels main-grid";
            gap: 5px; /* Adjust gap as needed */
            justify-content: center; /* Center the whole grid structure */
        }
        #colLabelContainer {
            grid-area: col-labels;
            display: grid; /* Will be set by JS */
            height: 30px; /* Height of label cells */
        }
        #rowLabelContainer {
            grid-area: row-labels;
            display: grid; /* Will be set by JS */
            width: 30px; /* Width of label cells */
        }
        #gridContainer {
            grid-area: main-grid;
            display: grid; /* Will be set by JS */
        }
        .label-cell {
            width: 40px; /* Match grid cell width for columns */
            height: 30px; /* Match colLabelContainer height for columns */
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 0.75rem;
            color: #4A5568;
        }
        #rowLabelContainer .label-cell {
            width: 30px; /* Match rowLabelContainer width */
            height: 40px; /* Match grid cell height */
        }

        .grid-cell {
            width: 40px;
            height: 40px;
            border: 1px solid black;
            background-color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: pointer;
            transition: background-color 0.2s;
            position: relative; 
            user-select: none; 
        }
        .grid-cell-center {
            background-color: #e2e8f0; /* Light grey for center */
        }
        .highlight-rotating { background-color: #90cdf4; } 
        .highlight-potential-pivot { background-color: #faf089; } 
        .highlight-pivot { background-color: #63b3ed; } 
        .highlight-destination { background-color: #4299e1; border: 2px solid #2c5282; } 
        .highlight-double-destination { background-color: #d6bcfa; border: 2px solid #805ad5; } 
        .node {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: 1px solid #4A5568; 
            box-sizing: border-box;
        }
        .node-red { background-color: #f56565; }
        .node-black { background-color: #4A5568; }
        .node-ghost {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            position: absolute; 
            opacity: 0.4;
            box-sizing: border-box;
            pointer-events: none; 
        }
        .node-red-ghost { border: 2px dashed #f56565; background-color: rgba(245, 101, 101, 0.1); }
        .node-black-ghost { border: 2px dashed #4A5568; background-color: rgba(74, 85, 104, 0.1); }
        .controls-container { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
        .info-box { min-height: 60px; }
        button, input[type="number"] { padding: 0.75rem 1rem; border-radius: 0.5rem; font-size: 1rem; }
        input[type="number"] { width: 80px; }

        /* Scrollable wrapper so the fixed-size grid never clips on small screens */
        .grid-scroll-wrapper {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        .grid-wrapper { min-width: max-content; }

        @media (max-width: 640px) {
            /* Buttons fill half the row so they stay tappable */
            .controls-container button {
                flex: 1 1 calc(50% - 0.25rem);
            }
        }
        
        #rotationSequence li {
            padding: 0.5rem 0;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            flex-direction: column; 
            gap: 0.5rem;
        }
        #rotationSequence li:last-child { border-bottom: none; }
        .mini-grid-container {
            display: grid;
            border: 1px solid #cbd5e0; 
            width: fit-content; 
        }
        .mini-grid-cell {
            width: 10px; 
            height: 10px;
            border: 1px solid #e2e8f0; 
            background-color: white;
            display: flex;
            justify-content: center;
            align-items: center;
        }
        .mini-grid-cell-center {
             background-color: #f7fafc; 
        }
        .mini-node {
            width: 7px;
            height: 7px;
            border-radius: 50%;
        }
        .mini-node-red { background-color: #f56565; }
        .mini-node-black { background-color: #4A5568; }

    </style>
</head>
<body class="bg-gray-100 min-h-screen flex flex-col items-center p-4 selection:bg-blue-200">

    <div class="w-full max-w-4xl bg-white p-6 rounded-lg shadow-xl">
        <h1 class="text-2xl font-bold mb-6 text-center text-gray-700">Robot Swarm Transformation Simulator</h1>

        <div class="mb-6 p-4 bg-gray-50 rounded-lg shadow">
            <div class="controls-container mb-4">
                <div>
                    <label for="gridSize" class="text-sm font-medium text-gray-700 mr-2">Grid Size (N x N, Odd):</label>
                    <input type="number" id="gridSize" value="11" min="3" max="21" step="2" class="border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500">
                </div>
                <button id="generateGridBtn" class="bg-blue-500 hover:bg-blue-600 text-white font-semibold rounded-md shadow">Generate Grid</button>
                <button id="defineTargetBtn" class="bg-purple-500 hover:bg-purple-600 text-white font-semibold rounded-md shadow">Define Target Shape</button>
                <button id="clearTargetBtn" class="bg-orange-500 hover:bg-orange-600 text-white font-semibold rounded-md shadow" disabled>Clear Target</button>
            </div>
            <div class="controls-container mb-4">
                 <button id="startTransformBtn" class="bg-green-500 hover:bg-green-600 text-white font-semibold rounded-md shadow" disabled>Start Transformation</button>
                 <button id="undoBtn" class="bg-yellow-500 hover:bg-yellow-600 text-white font-semibold rounded-md shadow" disabled>Undo Last Rotation</button>
                 <button id="resetTransformBtn" class="bg-cyan-500 hover:bg-cyan-600 text-white font-semibold rounded-md shadow" disabled>Reset Transformation</button>
                 <button id="restartBtn" class="bg-red-500 hover:bg-red-600 text-white font-semibold rounded-md shadow">Restart</button>
            </div>
             <div class="controls-container mb-4">
                <button id="copyLinkBtn" class="bg-gray-500 hover:bg-gray-600 text-white font-semibold rounded-md shadow">Get Share Link</button>
            </div>
            <div id="messageBox" class="info-box mt-2 p-3 bg-blue-100 border border-blue-300 text-blue-700 rounded-md text-sm">
                Set grid size (odd number) and click "Generate Grid". Then, click cells to place nodes for the initial shape.
            </div>
        </div>

        <div class="grid-scroll-wrapper mb-6">
            <div class="grid-wrapper">
                <div id="colLabelContainer"></div>
                <div id="rowLabelContainer"></div>
                <div id="gridContainer"></div>
            </div>
        </div>


        <div class="w-full mt-6">
            <h2 class="text-xl font-semibold mb-3 text-gray-700">Rotation History:</h2>
            <div class="bg-gray-50 p-4 rounded-lg shadow max-h-80 overflow-y-auto"> 
                <ul id="rotationSequence" class="text-sm text-gray-600"></ul>
            </div>
        </div>
    </div>

    <script src="../scripts/robot-swarms-client.js"></script>
</body>
</html>
