---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Active Membranes Notation Workbench</title>
    <link rel="icon" href="../favicon.ico">
    <script is:inline src="../theme-init.js"></script>
    <style is:global>
        body {
            font-family: 'IBM Plex Mono', monospace;
            background:
                linear-gradient(90deg, color-mix(in srgb, var(--accent-g) 16%, transparent) 1px, transparent 1px),
                linear-gradient(180deg, color-mix(in srgb, var(--accent-a) 12%, transparent) 1px, transparent 1px),
                var(--bg);
            background-size: 44px 44px;
            color: var(--text);
        }

        .workbench-shell {
            max-width: 1280px;
            width: 100%;
            margin: 0 auto;
            background: color-mix(in srgb, var(--surface) 94%, transparent);
            border: 1px solid var(--border);
            border-radius: 8px;
            box-shadow: 0 24px 80px rgba(0, 0, 0, 0.22);
            overflow: hidden;
        }

        .workbench-header {
            display: grid;
            gap: 1.25rem;
            grid-template-columns: minmax(0, 1fr);
            padding: clamp(1.5rem, 4vw, 3rem);
            border-bottom: 1px solid var(--border);
            background:
                linear-gradient(135deg, color-mix(in srgb, var(--accent-a) 20%, transparent), transparent 42%),
                linear-gradient(45deg, transparent, color-mix(in srgb, var(--accent-t) 14%, transparent));
        }

        .eyebrow {
            color: var(--accent-c);
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0;
            text-transform: uppercase;
        }

        .workbench-title {
            color: var(--text);
            font-size: clamp(2rem, 5vw, 4.4rem);
            font-weight: 800;
            line-height: 0.95;
            max-width: 12ch;
        }

        .workbench-subtitle {
            color: var(--text-sub);
            font-size: 1rem;
            line-height: 1.7;
            max-width: 68ch;
        }

        .status-strip {
            display: grid;
            gap: 0.75rem;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        }

        .status-tile {
            border-left: 3px solid var(--accent-a);
            background: var(--surface-2);
            padding: 0.85rem 1rem;
        }

        .status-tile strong {
            color: var(--text);
            display: block;
            font-size: 1.05rem;
        }

        .status-tile span {
            color: var(--text-muted);
            font-size: 0.78rem;
        }

        .workbench-main {
            display: grid;
            gap: 1rem;
            padding: clamp(1rem, 3vw, 2rem);
        }

        .section-panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 8px;
            min-width: 0;
            padding: 1rem;
        }

        .membrane-panel {
            overflow: hidden;
        }

        #visual-editor-area {
            height: clamp(34rem, 68vh, 46rem);
            max-width: 100%;
            overflow: auto;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 0.85rem;
        }

        .section-kicker {
            color: var(--accent-g);
            display: block;
            font-size: 0.72rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
            text-transform: uppercase;
        }

        .section-title {
            color: var(--text);
            font-size: 1.1rem;
            font-weight: 800;
        }

        .psystem-input-label {
            color: var(--text);
            display: block;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .copy-note {
            color: var(--text-muted);
            font-size: 0.78rem;
            line-height: 1.6;
        }

        .definition-grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .definition-card {
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: 6px;
            color: var(--text-sub);
            padding: 0.9rem;
        }

        .definition-card strong {
            color: var(--text);
            display: block;
            margin-bottom: 0.35rem;
        }

        .definition-card code {
            color: var(--accent-c);
            display: block;
            font-size: 0.78rem;
            white-space: normal;
        }

        .rules-workbench-grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: minmax(0, 0.92fr) minmax(380px, 1.08fr);
            min-width: 0;
        }

        #rule-examples-display,
        #rules-textarea,
        #log-output {
            background: color-mix(in srgb, var(--bg) 80%, var(--surface));
            border-color: var(--border);
            color: var(--text);
        }

        #rules-textarea {
            min-height: 27rem;
            resize: vertical;
        }

        .parser-table {
            min-width: 100%;
            color: var(--text);
            font-size: 0.85rem;
        }

        .parser-table th {
            background: var(--surface-2);
            color: var(--text-sub);
            font-weight: 800;
            padding: 0.7rem 0.9rem;
            text-align: left;
            text-transform: uppercase;
        }

        .parser-table td {
            border-top: 1px solid var(--border);
            padding: 0.7rem 0.9rem;
            vertical-align: top;
        }

        .source-cell {
            background: color-mix(in srgb, var(--bg) 70%, var(--surface));
            color: var(--text-sub);
            max-width: 34rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .status-badge {
            border-radius: 999px;
            display: inline-flex;
            font-size: 0.72rem;
            font-weight: 800;
            padding: 0.18rem 0.55rem;
        }

        .status-pass { background: color-mix(in srgb, var(--accent-a) 18%, transparent); color: var(--accent-a); }
        .status-fail { background: color-mix(in srgb, var(--accent-t) 18%, transparent); color: var(--accent-t); }
        .status-blocked { background: rgba(255, 209, 102, 0.18); color: var(--accent-c); }

        .result-item {
            background: var(--surface-2);
            border: 1px solid var(--border);
            border-radius: 6px;
            margin-bottom: 0.65rem;
            padding: 0.85rem;
        }

        .rule-tag {
            background: color-mix(in srgb, var(--accent-g) 16%, transparent);
            border: 1px solid color-mix(in srgb, var(--accent-g) 36%, transparent);
            color: var(--text);
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
            font-size: 0.8em;
            margin-right: 0.25rem;
            margin-bottom: 0.25rem;
            display: inline-block;
            font-family: monospace;
        }

        /* Membrane editor — inputs inside draggable cards */
        .membrane-draggable input[type="text"],
        .membrane-draggable select { width: 100%; padding: 6px; margin-top: 4px; margin-bottom: 8px; border: 1px solid #d1d5db; border-radius: 4px; font-size: 0.9em; }
        .membrane-draggable .input-group { margin-bottom: 8px; }
        .membrane-draggable label { font-size: 0.8em; font-weight: 500; color: var(--text-sub); display: block; margin-bottom: 2px; }
        .charge-select { font-family: monospace; }

        @media (max-width: 960px) {
            .definition-grid,
            .rules-workbench-grid {
                grid-template-columns: 1fr;
            }

            .membrane-panel,
            #visual-editor-area {
                height: 32rem;
            }
        }
    </style>
</head>
<body class="p-3 md:p-6">
    <div class="workbench-shell">
        <header class="workbench-header">
            <div>
                <p class="eyebrow">Active membranes / one-step semantics</p>
                <h1 class="workbench-title">Notation Workbench</h1>
                <p class="workbench-subtitle mt-4">Edit the membrane tree, write rules in standard active-membrane notation, then enumerate the exact maximally parallel rule multisets for the next transition.</p>
            </div>
            <div class="status-strip">
                <div class="status-tile"><strong>(a)-(d), (f)</strong><span>implemented rule families</span></div>
                <div class="status-tile"><strong>Line IDs</strong><span>parser output drives results</span></div>
                <div class="status-tile"><strong>One step</strong><span>maximally parallel enumeration</span></div>
            </div>
        </header>

        <main class="workbench-main">
        <section class="section-panel membrane-panel">
            <div class="section-header">
                <div>
                    <span class="section-kicker">Structure</span>
                    <h2 class="section-title">Membrane tree and initial state</h2>
                </div>
                <button id="add-membrane-btn" class="bg-green-500 hover:bg-green-600 text-white font-semibold py-1 px-3 rounded-md text-sm shadow">Add Membrane</button>
            </div>
            <div id="visual-editor-area" class="editor-area"></div>
        </section>

        <section class="section-panel">
          <div class="section-header">
            <div>
              <span class="section-kicker">Rule definition</span>
              <h2 class="section-title">Accepted active-membrane notation</h2>
            </div>
          </div>
          <div class="definition-grid">
            <div class="definition-card">
              <strong>Object rules</strong>
              <code>[h a -> v]h^0</code>
              <code>a [h]^- -> [h b]^+</code>
              <code>[h a]^+ -> [h]^- b</code>
            </div>
            <div class="definition-card">
              <strong>Structural rules</strong>
              <code>[h a]^0 -> lambda</code>
              <code>[h a]^0 -> [h b]^+ [h c]^-</code>
            </div>
            <div class="definition-card">
              <strong>Division over children</strong>
              <code>[h [g1]^+ [g2]^-]^0 -> [h [g1]^0]^0 [h [g2]^0]^0</code>
              <p class="copy-note mt-2">Elementary division parses but is blocked in one-step analysis for now.</p>
            </div>
          </div>
        </section>

        <section class="section-panel">
          <div class="section-header">
            <div>
              <span class="section-kicker">Rules</span>
              <h2 class="section-title">Rule textbox and parser validity</h2>
            </div>
          </div>
          <div class="rules-workbench-grid">
            <div>
              <label for="rules-textarea" class="psystem-input-label">Rules, one per line</label>
              <textarea id="rules-textarea" class="w-full p-3 border rounded-md font-mono text-sm" spellcheck="false"></textarea>
              <p class="copy-note mt-2">Blank lines and lines starting with # are ignored. Use a^2 for repeated objects and lambda for the empty multiset.</p>
            </div>
            <div>
              <label class="psystem-input-label">Parser validity</label>
              <div id="parse-results-container" class="overflow-x-auto border rounded-md">
                <p class="copy-note p-3">No rules parsed yet.</p>
              </div>
            </div>
          </div>
        </section>

        <div class="text-center mb-8">
            <button id="analyze-psystem-btn" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-3 px-8 rounded-md shadow-md transition duration-150 ease-in-out text-lg">
                Find Maximally Parallel Sets
            </button>
        </div>

        <section id="results-container" class="section-panel">
            <div class="section-header">
                <div>
                    <span class="section-kicker">Enumerator</span>
                    <h2 class="section-title">Analysis results</h2>
                </div>
            </div>
            <div id="error-display" class="mb-4"></div>
            <div id="maximally-parallel-sets-display" class="space-y-3">
                <p class="copy-note">No analysis performed yet.</p>
            </div>
        </section>
        
        <section class="section-panel">
            <div class="section-header">
                <div>
                    <span class="section-kicker">Trace</span>
                    <h2 class="section-title">Log</h2>
                </div>
            </div>
            <div id="log-output" class="h-48 overflow-y-auto text-xs p-3 border rounded-md"></div>
        </section>

        <section class="section-panel">
            <div class="section-header">
                <div>
                    <span class="section-kicker">Scope</span>
                    <h2 class="section-title">Model assumptions</h2>
                </div>
            </div>
            <p class="copy-note">
                Exact one-step maximally parallel analysis is implemented for rule types (a)-(d) and non-elementary division (f).
                Elementary division (e) is blocked until its full structural semantics are implemented.
            </p>
        </section>
        </main>
    </div>

    <script is:inline src="../membrane-editor.js"></script>
    <script is:inline src="../formal-step.js"></script>
    <script is:inline src="../active-membrane-parser.js"></script>
    <script is:inline src="../active-membrane-analysis.js"></script>
    <script src="../scripts/active-membranes-client.js"></script>
</body>
</html>
