---
import '../styles/global.css';
import { tools } from '../data/tools.js';
import ToolCard from '../components/ToolCard.astro';
---
<!DOCTYPE html>
<html lang="en" data-theme="dark" data-base-url={import.meta.env.BASE_URL}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Programmable Matter Lab</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🧬</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,600&family=IBM+Plex+Mono:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    /* ================================================================
       DESIGN TOKENS
    ================================================================ */
    :root[data-theme="dark"] {
      --bg:            #030e08;
      --surface:       #071410;
      --surface-2:     #0d211a;
      --border:        #1a3a28;
      --border-bright: #2d6048;
      --accent-a:      #00e88f;
      --accent-t:      #ff6b6b;
      --accent-g:      #38d4ff;
      --accent-c:      #ffd166;
      --text:          #b2e8c8;
      --text-sub:      #4a9068;
      --text-dim:      #273f30;
      --card-bg:       rgba(7, 20, 14, 0.88);
      --strand-1-r: 0;   --strand-1-g: 232; --strand-1-b: 143;
      --strand-2-r: 56;  --strand-2-g: 212; --strand-2-b: 255;
      --rung-0-r: 0;   --rung-0-g: 232; --rung-0-b: 143;
      --rung-1-r: 255; --rung-1-g: 107; --rung-1-b: 107;
      --rung-2-r: 56;  --rung-2-g: 212; --rung-2-b: 255;
      --rung-3-r: 255; --rung-3-g: 209; --rung-3-b: 102;
      --canvas-alpha: 0.55;
    }

    :root[data-theme="light"] {
      --bg:            #f2ede2;
      --surface:       #faf7ef;
      --surface-2:     #ede8da;
      --border:        #bdb49a;
      --border-bright: #7a9060;
      --accent-a:      #006835;
      --accent-t:      #b52b2b;
      --accent-g:      #0a5a80;
      --accent-c:      #b06010;
      --text:          #192318;
      --text-sub:      #547550;
      --text-dim:      #9aaa90;
      --card-bg:       rgba(250, 247, 239, 0.93);
      --strand-1-r: 0;   --strand-1-g: 104; --strand-1-b: 53;
      --strand-2-r: 10;  --strand-2-g: 90;  --strand-2-b: 128;
      --rung-0-r: 0;   --rung-0-g: 104; --rung-0-b: 53;
      --rung-1-r: 181; --rung-1-g: 43;  --rung-1-b: 43;
      --rung-2-r: 10;  --rung-2-g: 90;  --rung-2-b: 128;
      --rung-3-r: 176; --rung-3-g: 96;  --rung-3-b: 16;
      --canvas-alpha: 0.35;
    }

    /* ================================================================
       RESET & BASE
    ================================================================ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
      font-family: 'IBM Plex Mono', monospace;
      background: var(--bg);
      color: var(--text);
      overflow: hidden;
      transition: background 0.35s, color 0.35s;
    }

    /* ================================================================
       DNA CANVAS
    ================================================================ */
    #dna-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
    }

    /* ================================================================
       LAYOUT
    ================================================================ */
    #app {
      position: relative;
      z-index: 1;
      height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ================================================================
       HEADER
    ================================================================ */
    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 1.75rem;
      height: 58px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 0.625rem;
      cursor: pointer;
      user-select: none;
    }

    .logo-text {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--text);
      letter-spacing: 0.03em;
      white-space: nowrap;
    }

    .logo-text em { font-style: normal; color: var(--accent-a); }

    /* Logo SVG colours set via CSS so variables work */
    .logo-s1 { stroke: var(--accent-a); }
    .logo-s2 { stroke: var(--accent-g); }
    .logo-r0 { stroke: rgba(0,232,143,0.55); }
    .logo-r2 { stroke: rgba(56,212,255,0.55); }
    .logo-r1 { stroke: rgba(255,107,107,0.55); }
    [data-theme="light"] .logo-r0 { stroke: rgba(0,104,53,0.45); }
    [data-theme="light"] .logo-r2 { stroke: rgba(10,90,128,0.45); }
    [data-theme="light"] .logo-r1 { stroke: rgba(181,43,43,0.45); }

    /* Tool nav */
    .tool-nav { display: flex; align-items: center; gap: 2px; }

    .tool-tab {
      padding: 0.3rem 0.75rem;
      border-radius: 3px;
      font-size: 0.62rem;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
      border: 1px solid transparent;
      background: transparent;
      color: var(--text-sub);
      transition: all 0.2s;
      font-family: 'IBM Plex Mono', monospace;
      white-space: nowrap;
    }

    .tool-tab:hover {
      color: var(--text);
      border-color: var(--border-bright);
      background: var(--surface-2);
    }

    .tool-tab.active {
      color: var(--accent-a);
      border-color: var(--accent-a);
      background: rgba(0, 232, 143, 0.06);
    }

    [data-theme="light"] .tool-tab.active {
      background: rgba(0, 104, 53, 0.06);
    }

    /* Header right */
    .header-right {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .gh-link {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      color: var(--text-sub);
      transition: color 0.2s, background 0.2s;
      text-decoration: none;
    }

    .gh-link:hover {
      color: var(--text);
      background: var(--surface-2);
    }

    .theme-toggle {
      position: relative;
      width: 42px;
      height: 22px;
      border: 1px solid var(--border-bright);
      border-radius: 11px;
      background: var(--surface-2);
      cursor: pointer;
      transition: border-color 0.3s;
      flex-shrink: 0;
    }

    .theme-toggle::after {
      content: '';
      position: absolute;
      width: 15px;
      height: 15px;
      border-radius: 50%;
      background: var(--accent-a);
      top: 2.5px;
      left: 2.5px;
      transition: transform 0.3s cubic-bezier(.4,0,.2,1);
      box-shadow: 0 0 6px rgba(0,232,143,0.4);
    }

    [data-theme="light"] .theme-toggle::after {
      transform: translateX(20px);
      box-shadow: 0 0 6px rgba(0,104,53,0.3);
    }

    /* ================================================================
       MAIN + STACKED VIEWS
    ================================================================ */
    main {
      flex: 1;
      overflow: hidden;
      position: relative;
    }

    /* Both views sit absolutely inside main — only one visible at a time */
    #landing, #tool-view {
      position: absolute;
      inset: 0;
    }

    /* ================================================================
       LANDING
    ================================================================ */
    #landing {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      gap: 2.5rem;
    }

    .hero {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    .hero-eyebrow {
      font-size: 0.58rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--text-sub);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .hero-eyebrow::before, .hero-eyebrow::after {
      content: '';
      display: block;
      width: 24px;
      height: 1px;
      background: var(--border-bright);
    }

    h1 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2.2rem, 4.5vw, 3.6rem);
      font-weight: 600;
      line-height: 1.08;
      color: var(--text);
      letter-spacing: -0.01em;
    }

    h1 em { font-style: italic; color: var(--accent-a); }

    .hero-sub {
      font-size: 0.65rem;
      color: var(--text-sub);
      letter-spacing: 0.05em;
      max-width: 40ch;
      line-height: 1.8;
    }

    /* Tool cards */
    .tool-cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
      width: 100%;
      max-width: 860px;
    }

    /* ================================================================
       MOBILE
    ================================================================ */

    /* Cards: single column on narrow screens */
    @media (max-width: 700px) {
      .tool-cards { grid-template-columns: 1fr; max-width: 360px; }
    }

    /* Header: two-row layout on phones */
    @media (max-width: 580px) {
      header {
        height: auto;
        padding: 0.5rem 1rem;
        flex-wrap: wrap;
        row-gap: 0;
      }

      /* Row 1: logo + header-right controls */
      .logo { order: 1; flex: 1; }
      .header-right { order: 2; }

      /* Row 2: nav spans full width */
      .tool-nav {
        order: 3;
        width: 100%;
        justify-content: center;
        padding: 0.375rem 0 0.25rem;
        border-top: 1px solid var(--border);
      }

      .tool-tab {
        padding: 0.25rem 0.55rem;
        font-size: 0.6rem;
      }
    }

    /* Landing: scrollable + top-anchored on phones so no content is clipped */
    @media (max-width: 700px) {
      #landing {
        justify-content: flex-start;
        overflow-y: auto;
        padding-top: 1.75rem;
        padding-bottom: 2rem;
      }
    }

    /* Landing: tighter spacing on phones */
    @media (max-width: 480px) {
      #landing { padding: 1.25rem 1rem 2rem; gap: 1.5rem; }

      .hero-eyebrow { font-size: 0.62rem; }
      .hero-sub     { font-size: 0.7rem; }

      .card { padding: 1.25rem 1.125rem; }
      .card-desc { font-size: 0.68rem; }
    }

    .card {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 3px;
      padding: 1.625rem 1.375rem 1.375rem;
      cursor: pointer;
      transition: transform 0.25s cubic-bezier(.4,0,.2,1),
                  border-color 0.25s,
                  box-shadow 0.25s;
      position: relative;
      overflow: hidden;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }

    .card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 2px;
      background: var(--card-stripe);
      transform: scaleX(0.35);
      transform-origin: left;
      transition: transform 0.3s cubic-bezier(.4,0,.2,1);
    }

    .card:hover::before  { transform: scaleX(1); }

    .card:hover {
      border-color: var(--border-bright);
      transform: translateY(-4px);
      box-shadow: 0 12px 40px rgba(0,0,0,0.25);
    }

    .card:focus-visible { outline: 2px solid var(--accent-a); outline-offset: 2px; }

    .card[data-tool="membranes"] { --card-stripe: linear-gradient(90deg, var(--accent-a), var(--accent-g)); }
    .card[data-tool="psystems"]  { --card-stripe: linear-gradient(90deg, var(--accent-g), var(--accent-c)); }
    .card[data-tool="swarms"]    { --card-stripe: linear-gradient(90deg, var(--accent-c), var(--accent-t)); }

    .card-tag {
      font-size: 0.55rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--text-dim);
      margin-bottom: 1rem;
    }

    .card-icon {
      width: 40px;
      height: 40px;
      margin-bottom: 0.875rem;
      color: var(--text-sub);
      transition: color 0.2s;
    }

    .card:hover .card-icon { color: var(--text); }

    .card-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.3rem;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 0.5rem;
      line-height: 1.2;
    }

    .card-desc {
      font-size: 0.63rem;
      line-height: 1.7;
      color: var(--text-sub);
    }

    .card-cta {
      margin-top: 1.25rem;
      display: flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 0.6rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--text-dim);
      transition: color 0.2s, gap 0.2s;
    }

    .card:hover .card-cta { color: var(--accent-a); gap: 0.625rem; }

    /* DNA sequence ticker */
    .seq-ticker {
      font-size: 0.5rem;
      letter-spacing: 0.25em;
      color: var(--text-dim);
      overflow: hidden;
      white-space: nowrap;
      max-width: 860px;
      width: 100%;
      mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
      -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    }

    /* ================================================================
       TOOL VIEW
    ================================================================ */
    #tool-view {
      display: none;
      flex-direction: column;
    }

    #tool-view.active { display: flex; }

    #tool-frame {
      flex: 1;
      width: 100%;
      border: none;
    }
  </style>
</head>
<body>

<canvas id="dna-canvas" aria-hidden="true"></canvas>

<div id="app">
  <header>
    <div class="logo" onclick="showLanding()" role="button" tabindex="0"
         onkeydown="if(event.key==='Enter')showLanding()" aria-label="Return to lab home">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <path class="logo-s1" d="M6 4 C9 7, 11 10, 14 14 C17 18, 19 21, 22 24" stroke-width="2" stroke-linecap="round"/>
        <path class="logo-s2" d="M22 4 C19 7, 17 10, 14 14 C11 18, 9 21, 6 24" stroke-width="2" stroke-linecap="round"/>
        <line class="logo-r0" x1="8.5" y1="9"  x2="19.5" y2="9"  stroke-width="1.2" stroke-linecap="round"/>
        <line class="logo-r2" x1="10"  y1="14" x2="18"   y2="14" stroke-width="1.2" stroke-linecap="round"/>
        <line class="logo-r1" x1="8.5" y1="19" x2="19.5" y2="19" stroke-width="1.2" stroke-linecap="round"/>
      </svg>
      <span class="logo-text">Programmable <em>Matter</em> Lab</span>
    </div>

    <nav class="tool-nav" aria-label="Tools">
      <button class="tool-tab active" id="tab-home"
              onclick="showLanding()" aria-current="page">Lab</button>
      {tools.map(tool => (
        <button class="tool-tab" id={`tab-${tool.id}`}
                onclick={`openTool('${tool.path}','${tool.id}')`}>{tool.title.split(' ')[0]}</button>
      ))}
    </nav>

    <div class="header-right">
      <a class="gh-link" href="https://github.com/Theosdoor/programmable-matter-lab"
         target="_blank" rel="noopener noreferrer" aria-label="View on GitHub" title="View on GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
      <button class="theme-toggle" onclick="toggleTheme()"
              aria-label="Toggle light/dark mode" title="Toggle theme"></button>
    </div>
  </header>

  <main>
    <div id="landing" role="main">
      <div class="hero">
        <p class="hero-eyebrow">Computational models of living systems</p>
        <h1>Programmable<br><em>Matter</em></h1>
        <p class="hero-sub">Three tools for simulating bio-inspired computation — membrane systems, P-systems, and robot swarms.</p>
      </div>

      <div class="tool-cards">
        {tools.map(tool => <ToolCard tool={tool} />)}
      </div>

      <div class="seq-ticker" id="seq-ticker" aria-hidden="true"></div>
    </div>

    <div id="tool-view">
      <iframe id="tool-frame" src="" title="Selected tool" allowfullscreen></iframe>
    </div>
  </main>
</div>

<script src="../scripts/index-client.js"></script>
</body>
</html>
